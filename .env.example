# API do Querido Diário (busca full-text em diários oficiais municipais)
QD_API_BASE=https://api.queridodiario.ok.org.br

# API de localidades do IBGE (enumeração de municípios por UF)
IBGE_API_BASE=https://servicodados.ibge.gov.br/api/v1

# Banco SQLite de saída (resumível)
QD_DB_PATH=data/qdedu.sqlite

# Rate limit em requisições por segundo
QD_RATE_RPS=2.0

# User-Agent das requisições HTTP
QD_USER_AGENT=qdedu/0.1 (+prospeccao)
